# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --------------------------------------------------
# Groq (LLM + vision model)
# --------------------------------------------------
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Recommended in production: managed Postgres connection string. If set, it takes precedence over DB_* values.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# --------------------------------------------------
# PostgreSQL + pgvector
# --------------------------------------------------
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=YOUR_DB_HOST
DB_PORT=5433
DB_NAME=research_agent

# --------------------------------------------------
# Auth
# --------------------------------------------------
# Generate a real secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=YOUR_JWT_SECRET

# --------------------------------------------------
# CORS (production)
# --------------------------------------------------
# Your deployed frontend URL, e.g. https://your-app.vercel.app
# Leave empty for local development (localhost:3000 is always allowed).
FRONTEND_URL=

# Server-side upload limits
MAX_PDF_BYTES=26214400
MAX_IMAGE_BYTES=4194304
