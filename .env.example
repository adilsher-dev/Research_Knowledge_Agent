# ---- backend/.env ----
GROQ_API_KEY=YOUR_GROQ_API_KEY

# For managed Postgres (recommended in production), set this and leave the DB_* values unused.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Local-development fallback if DATABASE_URL is empty
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5433
DB_NAME=research_agent

JWT_SECRET=YOUR_JWT_SECRET      # python -c "import secrets; print(secrets.token_urlsafe(64))"
FRONTEND_URL=YOUR_FRONTEND_URL  # e.g. https://your-app.vercel.app (CORS)

MAX_PDF_BYTES=26214400
MAX_IMAGE_BYTES=4194304

# ---- frontend/.env.local ----
NEXT_PUBLIC_API_BASE_URL=YOUR_BACKEND_URL   # e.g. http://localhost:8000
